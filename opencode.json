{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "atlassian-mcp-server": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true,
      "headers": {
        "Authorization": "{env:ATLASSIAN_TOKEN}"
      }
    },
    "figma-mcp-server": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": true
    },
    
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true
    },
    "figma-console": {
      "type": "local",
      "command": ["npx", "-y", "figma-console-mcp@latest"],
      "enabled": true,
      "environment": {
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_CONSOLE_TOKEN}",
        "ENABLE_MCP_APPS": "true"
      }
    },
    "figma-local":{
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    }
  }
}
