{
	"servers": {
		"atlassian": {
			"url": "https://mcp.atlassian.com/v1/mcp/authv2",
			"type": "http",
			"headers": {
				"Authorization": "${input:atlassianToken}"
			}
		},
		
		"figma": {
			"url": "https://mcp.figma.com/mcp",
			"type": "http"
		},
		
		"playwright": { 
      		"command": "/bin/zsh",
			"args": [
				"-i",
				"-c",
				"npx -y @playwright/mcp@latest"
			],
			"type": "stdio"
		},
		
		"github": {
      		"type": "http",
      		"url": "https://api.githubcopilot.com/mcp/"
    	},

		"figma-console": {
			"command": "/bin/zsh",
			"args": [
				"-i",
				"-c",
				"npx -y figma-console-mcp@latest"
			],
			"type": "stdio",
			"env": {
				"FIGMA_ACCESS_TOKEN": "${input:figmaConsoleToken}",
				"ENABLE_MCP_APPS": "true"
			}
   		}
	},
	"inputs": [
		{
			"id": "atlassianToken",
			"type": "promptString",
			"description": "Atlassian API Token (format: Basic <base64>)",
			"password": true   // ← stored encrypted
		},
		{
			"id": "figmaConsoleToken",
			"type": "promptString",
			"description": "Figma Console MCP Access Token",
			"password": true   // ← stored encrypted
		}
	]
}