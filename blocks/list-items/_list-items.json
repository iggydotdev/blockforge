{
  "definitions": [
    {
      "title": "List Items",
      "id": "list-items",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List Items",
              "model": "list-items",
              "filter": "list-items"
            }
          }
        }
      }
    },
    {
      "title": "List Item",
      "id": "list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "List Item",
              "model": "list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list-items",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "variant",
          "label": "List Type",
          "value": "unordered",
          "options": [
            { "name": "Unordered", "value": "unordered" },
            { "name": "Ordered", "value": "ordered" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listStyleOrdered",
          "label": "Style",
          "value": "decimal",
          "condition": {
            "===": [{ "var": "variant" }, "ordered"]
          },
          "options": [
            { "name": "Numerical (1, 2, 3)", "value": "decimal" },
            { "name": "Upper Roman (I, II, III)", "value": "upper-roman" },
            { "name": "Lower Roman (i, ii, iii)", "value": "lower-roman" },
            { "name": "Upper Alphabetical (A, B, C)", "value": "upper-alpha" },
            { "name": "Lower Alphabetical (a, b, c)", "value": "lower-alpha" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listStyleUnordered",
          "label": "Style",
          "value": "",
          "condition": {
            "===": [{ "var": "variant" }, "unordered"]
          },
          "options": [
            { "name": "Default bullet", "value": "" },
            { "name": "Checkmark", "value": "checkmark" },
            { "name": "Arrow Right", "value": "right-arrow" },
            { "name": "Star", "value": "star" },
            { "name": "Circle", "value": "circle" },
            { "name": "Square", "value": "square" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "startValue",
          "label": "Starting Value",
          "description": "Where the top-level ordered list begins. Accepts a number (5), a letter (C \u2192 3), or a Roman numeral (III \u2192 3). Ignored for unordered lists.",
          "value": "",
          "condition": {
            "===": [{ "var": "variant" }, "ordered"]
          }
        }
      ]
    },
    {
      "id": "list-item",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemIndent",
          "label": "Indent Level",
          "description": "How deeply this item is nested. Up to 3 levels are supported.",
          "value": "0",
          "options": [
            { "name": "Level 1 (top)", "value": "0" },
            { "name": "Level 2", "value": "1" },
            { "name": "Level 3", "value": "2" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemNestedVariant",
          "label": "Sub-list Type",
          "description": "Only used when this item opens a deeper sub-list (its Indent Level is greater than the previous item's). Leave as Inherit to use the parent list's type.",
          "value": "",
          "options": [
            { "name": "Inherit from parent", "value": "" },
            { "name": "Ordered", "value": "ordered" },
            { "name": "Unordered", "value": "unordered" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemNestedStyleOrdered",
          "label": "Sub-list Style",
          "description": "Style for the sub-list this item opens (ordered).",
          "value": "decimal",
          "condition": {
            "===": [{ "var": "listItemNestedVariant" }, "ordered"]
          },
          "options": [
            { "name": "Numerical (1, 2, 3)", "value": "decimal" },
            { "name": "Upper Roman (I, II, III)", "value": "upper-roman" },
            { "name": "Lower Roman (i, ii, iii)", "value": "lower-roman" },
            { "name": "Upper Alphabetical (A, B, C)", "value": "upper-alpha" },
            { "name": "Lower Alphabetical (a, b, c)", "value": "lower-alpha" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemNestedStyleUnordered",
          "label": "Sub-list Style",
          "description": "Style for the sub-list this item opens (unordered).",
          "value": "",
          "condition": {
            "===": [{ "var": "listItemNestedVariant" }, "unordered"]
          },
          "options": [
            { "name": "Default bullet", "value": "" },
            { "name": "Checkmark", "value": "checkmark" },
            { "name": "Arrow Right", "value": "right-arrow" },
            { "name": "Star", "value": "star" },
            { "name": "Circle", "value": "circle" },
            { "name": "Square", "value": "square" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "listItemStartValue",
          "label": "Restart Numbering At",
          "description": "Optional. Restarts numbering at this value on the surrounding ordered list. Accepts a number (5), a letter (C \u2192 3), or a Roman numeral (III \u2192 3). Ignored when the surrounding list is unordered.",
          "value": ""
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "listItemTextContent",
          "label": "List item content",
          "description": "The text content of the list item. Supports rich text formatting.",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "list-items",
      "components": [
        "list-item"
      ]
    },
    {
      "id": "list-item",
      "components": [
        "richtext",
        "text",
        "title"
      ]
    }
  ]
}
