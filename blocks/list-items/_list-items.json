{
  "definitions": [
    {
      "title": "List Items",
      "id": "list-items",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List Items",
              "model": "list-items",
              "filter": "list-items"
            }
          }
        }
      }
    },
    {
      "title": "List Item",
      "id": "list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "List Item",
              "model": "list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list-items",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "variant",
          "label": "List Type",
          "value": "unordered",
          "options": [
            { "name": "Unordered", "value": "unordered" },
            { "name": "Ordered", "value": "ordered" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listStyleOrdered",
          "label": "Style",
          "value": "decimal",
          "condition": {
            "===": [{ "var": "variant" }, "ordered"]
          },
          "options": [
            { "name": "Numerical (1, 2, 3)", "value": "decimal" },
            { "name": "Upper Roman (I, II, III)", "value": "upper-roman" },
            { "name": "Upper Alphabetical (A, B, C)", "value": "upper-alpha" },
            { "name": "Lower Alphabetical (a, b, c)", "value": "lower-alpha" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listStyleUnordered",
          "label": "Style",
          "value": "",
          "condition": {
            "===": [{ "var": "variant" }, "unordered"]
          },
          "options": [
            { "name": "Default bullet", "value": "" },
            { "name": "Checkmark", "value": "checkmark" },
            { "name": "Arrow Right", "value": "right-arrow" },
            { "name": "Star", "value": "star" },
            { "name": "Circle", "value": "circle" },
            { "name": "Square", "value": "square" }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "startValue",
          "label": "Starting Value",
          "description": "Sets where the top-level ordered list begins. Accepts a number (e.g. 5), a letter (e.g. C → 3), or a Roman numeral (e.g. III → 3). Ignored for unordered lists.",
          "value": "",
          "condition": {
            "===": [{ "var": "variant" }, "ordered"]
          }
        }
      ]
    },
    {
      "id": "list-item",
      "fields": [
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemIndent",
          "label": "Indent Level",
          "value": "0",
          "options": [
            { "name": "Level 1 (top)", "value": "0" },
            { "name": "Level 2", "value": "1" },
            { "name": "Level 3", "value": "2" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listItemNestedStyle",
          "label": "Nested List Style",
          "description": "Used only when this item starts a deeper sub-list (its Indent Level is greater than the previous item's). Leave as Inherit to use the parent list's style.",
          "value": "",
          "options": [
            { "name": "Inherit from parent", "value": "" },
            { "name": "Ordered – Numerical (1, 2, 3)", "value": "ordered-decimal" },
            { "name": "Ordered – Upper Roman (I, II, III)", "value": "ordered-upper-roman" },
            { "name": "Ordered – Upper Alpha (A, B, C)", "value": "ordered-upper-alpha" },
            { "name": "Ordered – Lower Alpha (a, b, c)", "value": "ordered-lower-alpha" },
            { "name": "Unordered – Default bullet", "value": "unordered-default" },
            { "name": "Unordered – Checkmark", "value": "unordered-checkmark" },
            { "name": "Unordered – Arrow Right", "value": "unordered-right-arrow" },
            { "name": "Unordered – Star", "value": "unordered-star" },
            { "name": "Unordered – Circle", "value": "unordered-circle" },
            { "name": "Unordered – Square", "value": "unordered-square" }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "listItemTextContent",
          "label": "List item content",
          "description": "The text content of the list item. Supports rich text formatting.",
          "value": ""
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "list-items",
      "components": [
        "list-item"
      ]
    },
    {
      "id": "list-item",
      "components": [
        "richtext",
        "text",
        "title"
      ]
    }
  ]
}
